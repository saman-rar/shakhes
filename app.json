{
  "expo": {
    "name": "shakhes",
    "slug": "shakhes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/shakhes.png",
    "scheme": "shakhes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/shakhes.png",
        "backgroundImage": "./assets/images/shakhes.png",
        "monochromeImage": "./assets/images/shakhes.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/shakhes.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/sepah-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
