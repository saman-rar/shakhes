{
  "expo": {
    "name": "شاخص",
    "slug": "shakhes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/shakhes.png",
    "scheme": "shakhes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/shakhes.png",
        "backgroundImage": "./assets/images/shakhes.png",
        "monochromeImage": "./assets/images/shakhes.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fsfardar.shakhes"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/shakhes.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F28B0C",
          "image": "./assets/images/sepah-logo.png",
          "imageWidth": 300
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7809bcf3-0138-4b0c-bd58-0b25fffb288f"
      }
    }
  }
}
